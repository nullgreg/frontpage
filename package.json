{
  "name": "frontpage",
  "version": "1.4.0",
  "private": true,
  "description": "A dark-glass new tab and home page extension for Firefox, Chrome and Safari",
  "scripts": {
    "start": "web-ext run --source-dir extension",
    "build:chrome": "node dev/build.mjs",
    "start:chrome": "node dev/build.mjs && web-ext run --target chromium --source-dir dist/chrome",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --overwrite-dest",
    "sign": "node --env-file=.env node_modules/web-ext/bin/web-ext.js sign --channel=unlisted --source-dir extension",
    "safari:install": "node dev/safari.mjs install",
    "safari:renew": "node dev/safari.mjs renew",
    "safari:status": "node dev/safari.mjs status",
    "safari:schedule": "node dev/safari.mjs schedule",
    "safari:unschedule": "node dev/safari.mjs unschedule"
  },
  "devDependencies": {
    "@magicelk235/aqueduct": "1.18.3",
    "web-ext": "^10.8.0"
  }
}
